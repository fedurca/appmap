[Unit]
Description=Commatrix central collector server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=-/etc/commatrix/server.env
ExecStart=/usr/bin/commatrix serve --database /var/lib/commatrix/central.db --host 127.0.0.1 --port 8899
Restart=on-failure
RestartSec=5
StateDirectory=commatrix

[Install]
WantedBy=multi-user.target
