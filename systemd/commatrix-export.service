[Unit]
Description=Commatrix snapshot export/push to central collector
Documentation=https://github.com/fedurca/appmap
After=commatrix-collector.service

[Service]
Type=oneshot
# Export only reads the local database and writes a snapshot, so it must not
# run as root. The collector already creates /var/lib/commatrix as 0750
# commatrix:commatrix.
User=commatrix
Group=commatrix

# Either write a snapshot to disk (for ssh/rsync pull) ...
ExecStart=/usr/bin/commatrix export --config /etc/commatrix/commatrix.conf -o /var/lib/commatrix/snapshots/%H.json

# ... or push directly to a central collector. Uncomment both lines below and
# put the token in the environment file, never in ExecStart: unit files are
# world-readable, so a token here leaks to every local user.
#
#   printf 'COMMATRIX_TOKEN=%s\n' "$(cat /path/to/shared-token)" \
#       > /etc/commatrix/push.env
#   chown root:commatrix /etc/commatrix/push.env
#   chmod 0640 /etc/commatrix/push.env
#
# EnvironmentFile=/etc/commatrix/push.env
# ExecStart=/usr/bin/commatrix push --config /etc/commatrix/commatrix.conf --server https://central.example.com:8899

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
UMask=0027
StateDirectory=commatrix
StateDirectoryMode=0750

# --- Generic confinement (systemd-analyze security --offline=true) --------
# The export job only reads the database and writes a JSON snapshot into the
# StateDirectory, so it can take the full set: unlike the collector it never
# touches /proc/sys and never opens a packet socket.
ProtectHostname=true
ProtectClock=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictNamespaces=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @debug @mount @swap @reboot
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RemoveIPC=true
# ProtectProc=invisible hides other processes; the export job only reads its
# own database. ProcSubset=pid is deliberately NOT set - it would also hide
# /proc/meminfo and friends, which the host-parameter fallback reads.
ProtectProc=invisible
# IPAddressDeny=any is deliberately NOT set: this unit doubles as the 'push'
# transport (see the commented ExecStart above), which needs egress to the
# central server. If you keep the default local-export ExecStart, adding
#     IPAddressDeny=any
# here costs nothing; if you enable push, allow the central host explicitly
#     IPAddressDeny=any
#     IPAddressAllow=<central-ip>/32
